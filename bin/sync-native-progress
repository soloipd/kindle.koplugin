#!/bin/sh

# Persist one exact converted-EPUB position through Kindle's ReaderSDK.
set -u

JAVA_BIN="/usr/java/bin/java"
PLUGIN_DIR="/mnt/us/koreader/plugins/kindle.koplugin"
AGENT_JAR="$PLUGIN_DIR/bin/native-reading-progress-agent-v7.jar"
LAUNCHER_CLASSES="$PLUGIN_DIR/bin/classes"
LOCK_FILE="/tmp/kindle-progress-sync.lock"
ATTACH_LOG="/tmp/kindle-progress-attach.log"
PUBLISHED_RESULT="/mnt/us/koreader/settings/kindle_native_progress_debug.log"
ATTACH_TIMEOUT_SECONDS=12
RESULT_POLL_ATTEMPTS=12
LOCK_PUBLISH_ATTEMPTS=3
lock_acquired=0
request_result=""
owner_dir=""
owner_temp=""
owner_token=""
private_result=""

if [ "$#" -lt 1 ] || [ "$#" -gt 2 ]; then exit 2; fi
payload="$1"
case "$payload" in
    /tmp/kindle-progress-[0-9]*.properties) ;;
    *) exit 2 ;;
esac
payload_name="${payload#/tmp/kindle-progress-}"
payload_id="${payload_name%.properties}"
[ "$payload_name" = "$payload_id.properties" ] || exit 2
case "$payload_id" in ''|*[!0-9]*) exit 2 ;; esac
if [ "$#" -eq 2 ]; then
    private_result="$2"
    case "$private_result" in
        /tmp/kindle-progress-worker-[0-9]*.log) ;;
        *) exit 2 ;;
    esac
    private_name="${private_result#/tmp/kindle-progress-worker-}"
    private_id="${private_name%.log}"
    [ "$private_name" = "$private_id.log" ] || exit 2
    case "$private_id" in ''|*[!0-9]*) exit 2 ;; esac
    [ "$private_id" = "$payload_id" ] || exit 2
fi

# shellcheck disable=SC2329 # invoked by EXIT/HUP/INT/TERM traps
cleanup() {
    rm -f "$payload"
    if [ -n "$request_result" ]; then rm -f "$request_result"; fi
    if [ "$lock_acquired" -eq 1 ]; then
        published_owner="$(sed -n '1p' "$LOCK_FILE" 2>/dev/null)"
        if test "$published_owner" = "$owner_token"; then
            rm -f "$LOCK_FILE"
        fi
    fi
    if [ -n "$owner_temp" ]; then rm -f "$owner_temp"; fi
    if [ -n "$owner_dir" ]; then rmdir "$owner_dir" 2>/dev/null || true; fi
}
trap cleanup EXIT HUP INT TERM

if [ ! -f "$payload" ] || [ ! -x "$JAVA_BIN" ] || [ ! -r "$AGENT_JAR" ] \
    || [ ! -r "$LAUNCHER_CLASSES/AttachLauncher.class" ]; then exit 3; fi
asin="$(sed -n 's/^asin=//p' "$payload" | sed -n '1p')"
request_id="$(sed -n 's/^request_id=//p' "$payload" | sed -n '1p')"
printf '%s\n' "$asin" | grep -Eq '^B[A-Z0-9]{9}$' || exit 2
case "$request_id" in ''|*[!0-9]*) exit 2 ;; esac
request_result="/tmp/kindle-progress-result-$request_id.log"

owner_token="$$:$request_id"
umask 077
owner_dir="$(mktemp -d "/tmp/kindle-progress-sync.XXXXXX")" || exit 9
owner_temp="$owner_dir/owner"
printf '%s\n' "$owner_token" >"$owner_temp" || exit 9
chmod 0600 "$owner_temp" || exit 9

# v0.0.7 used a directory lock and could briefly expose it before publishing
# its PID. Wait for an in-flight legacy owner before removing only a stale
# upgrade remnant. New locks below are hard links to a fully written token, so
# ownership publication itself is atomic.
if [ -d "$LOCK_FILE" ]; then
    publish_attempt=0
    legacy_pid=""
    while [ "$publish_attempt" -lt "$LOCK_PUBLISH_ATTEMPTS" ]; do
        if [ -f "$LOCK_FILE/pid" ]; then
            legacy_pid="$(sed -n '1p' "$LOCK_FILE/pid")"
            break
        fi
        publish_attempt=$((publish_attempt + 1))
        sleep 1
    done
    case "$legacy_pid" in
        ''|*[!0-9]*) ;;
        *) if kill -0 "$legacy_pid" 2>/dev/null; then exit 75; fi ;;
    esac
    rm -f "$LOCK_FILE/pid"
    if ! rmdir "$LOCK_FILE" 2>/dev/null; then exit 75; fi
fi

if ! ln "$owner_temp" "$LOCK_FILE" 2>/dev/null; then
    published_owner="$(sed -n '1p' "$LOCK_FILE" 2>/dev/null)"
    owner_pid="${published_owner%%:*}"
    owner_request="${published_owner#*:}"
    owner_is_live=0
    if [ "$published_owner" != "$owner_pid" ]; then
        case "$owner_pid" in ''|*[!0-9]*) ;;
            *)
                case "$owner_request" in ''|*[!0-9]*) ;;
                    *) if kill -0 "$owner_pid" 2>/dev/null; then owner_is_live=1; fi ;;
                esac
                ;;
        esac
    fi
    if [ "$owner_is_live" -eq 1 ]; then exit 75; fi

    current_owner="$(sed -n '1p' "$LOCK_FILE" 2>/dev/null)"
    if [ "$current_owner" != "$published_owner" ]; then exit 75; fi
    rm -f "$LOCK_FILE"
    if ! ln "$owner_temp" "$LOCK_FILE" 2>/dev/null; then exit 75; fi
fi
lock_acquired=1
rm -f "$owner_temp"
owner_temp=""
if ! rmdir "$owner_dir"; then exit 9; fi
owner_dir=""
framework_pid="$(ps -eo pid,args 2>/dev/null \
    | awk '/ch.ethz.iks.concierge.framework.Framework/ && !/awk/ { print $1; exit }')"
case "$framework_pid" in ''|*[!0-9]*) exit 5 ;; esac
framework_uid="$(awk '/^Uid:/ { print $2; exit }' "/proc/$framework_pid/status" 2>/dev/null)"
framework_gid="$(awk '/^Gid:/ { print $2; exit }' "/proc/$framework_pid/status" 2>/dev/null)"
case "$framework_uid:$framework_gid" in *[!0-9:]*|:|:*|*:) exit 5 ;; esac

chown "$framework_uid:$framework_gid" "$payload" || exit 9
chmod 0600 "$payload" || exit 9
rm -f "$request_result"
if ! timeout "$ATTACH_TIMEOUT_SECONDS" \
    "$JAVA_BIN" --add-modules jdk.attach -cp "$LAUNCHER_CLASSES" \
    AttachLauncher "$framework_pid" "$AGENT_JAR" "$payload" >"$ATTACH_LOG" 2>&1; then
    exit 6
fi

attempt=0
while [ "$attempt" -lt "$RESULT_POLL_ATTEMPTS" ]; do
    if [ -f "$request_result" ] \
        && grep -Fqx "request_id=$request_id" "$request_result" \
        && grep -Eq '^success=(true|false)$' "$request_result"; then break; fi
    attempt=$((attempt + 1))
    sleep 1
done
if ! grep -Fqx "request_id=$request_id" "$request_result" \
    || ! grep -Fqx "asin=$asin" "$request_result" \
    || ! grep -Fqx 'success=true' "$request_result"; then
    if [ -f "$request_result" ]; then cp "$request_result" "$PUBLISHED_RESULT" 2>/dev/null || true; fi
    exit 7
fi
published_temp="$PUBLISHED_RESULT.$$"
if ! cp "$request_result" "$published_temp" || ! mv -f "$published_temp" "$PUBLISHED_RESULT"; then
    rm -f "$published_temp"
    exit 8
fi
if [ -n "$private_result" ]; then
    private_temp="$private_result.$$"
    if ! cp "$request_result" "$private_temp" \
        || ! chmod 0600 "$private_temp" \
        || ! mv -f "$private_temp" "$private_result"; then
        rm -f "$private_temp"
        exit 8
    fi
fi
exit 0
